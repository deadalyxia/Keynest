<local:ChromeWindow x:Class="VaultApp.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VaultApp.Views"
        Width="480" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#080810"
        ShowInTaskbar="False">

    <Border Background="#080810" BorderBrush="#1E1E32" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="#080810" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="20,0,0,0">
                    <TextBlock x:Name="DialogTitleBar" Text="Settings" FontSize="13"
                               FontWeight="Medium" Foreground="#9A9088"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ChromeCloseButton}"
                                Content="&#xE8BB;" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <Border Grid.Row="1" BorderBrush="#13131F" BorderThickness="0,1,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="BodyPanel" Margin="24,20,24,24"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</local:ChromeWindow>
