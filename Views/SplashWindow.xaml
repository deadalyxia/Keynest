<local:ChromeWindow x:Class="VaultApp.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VaultApp.Views"
        Width="340" Height="240"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#080810">

    <Border Background="#080810" BorderBrush="#1E1E32" BorderThickness="1" CornerRadius="14">
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <!-- Key icon -->
                <Canvas Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <!-- Key circle -->
                    <Ellipse x:Name="KeyRing" Canvas.Left="2" Canvas.Top="8"
                             Width="20" Height="20"
                             Stroke="#7B5CF0" StrokeThickness="2.5" Fill="Transparent"
                             Opacity="0"/>
                    <!-- Key shaft -->
                    <Path x:Name="KeyShaft"
                          Data="M20,18 L42,18 M36,18 L36,24 M30,18 L30,22"
                          Stroke="#7B5CF0" StrokeThickness="2.5" Fill="Transparent"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeDashArray="40" StrokeDashOffset="40"
                          Opacity="0"/>
                </Canvas>

                <!-- Wordmark -->
                <TextBlock x:Name="WordMark" Text="KEYNEST"
                           FontFamily="Segoe UI Light" FontSize="26" FontWeight="Light"
                           Foreground="#EEEAF8" HorizontalAlignment="Center"
                           Margin="0,0,0,5" Opacity="0"/>

                <TextBlock Text="PASSWORD MANAGER"
                           FontFamily="Segoe UI" FontSize="8" Foreground="#4A4468"
                           HorizontalAlignment="Center" Margin="0,0,0,0" Opacity="0"
                           x:Name="Tagline"/>

            </StackPanel>

            <!-- Progress bar -->
            <Border VerticalAlignment="Bottom" Margin="40,0,40,22"
                    Height="2" Background="#13131F" CornerRadius="1">
                <Border x:Name="LoadBar" HorizontalAlignment="Left"
                        Width="0" Background="#7B5CF0" CornerRadius="1"/>
            </Border>
        </Grid>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Key ring fades in -->
                    <DoubleAnimation Storyboard.TargetName="KeyRing"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.1"/>
                    <!-- Key shaft draws -->
                    <DoubleAnimation Storyboard.TargetName="KeyShaft"
                                     Storyboard.TargetProperty="StrokeDashOffset"
                                     From="40" To="0" Duration="0:0:0.5" BeginTime="0:0:0.25">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="KeyShaft"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.2" BeginTime="0:0:0.25"/>
                    <!-- Wordmark fades in -->
                    <DoubleAnimation Storyboard.TargetName="WordMark"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.5" BeginTime="0:0:0.5">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <!-- Tagline -->
                    <DoubleAnimation Storyboard.TargetName="Tagline"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.7"/>
                    <!-- Load bar fills -->
                    <DoubleAnimation Storyboard.TargetName="LoadBar"
                                     Storyboard.TargetProperty="Width"
                                     From="0" To="260" Duration="0:0:1.3" BeginTime="0:0:0.15">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</local:ChromeWindow>
