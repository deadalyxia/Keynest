<local:ChromeWindow x:Class="VaultApp.Views.EntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VaultApp.Views"
        Width="500" Height="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#080810"
        ShowInTaskbar="False">

    <Border Background="#080810" BorderBrush="#1E1E32" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="20,0,0,0">
                    <TextBlock x:Name="DialogTitle" Text="New Entry" FontSize="13"
                               FontWeight="Medium" Foreground="#9A9088" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Style="{StaticResource ChromeCloseButton}"
                            Content="&#xE8BB;" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Body -->
            <Border Grid.Row="1" BorderBrush="#13131F" BorderThickness="0,1,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FormPanel" Margin="24,18,24,8"/>
                </ScrollViewer>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#080810" BorderBrush="#13131F" BorderThickness="0,1,0,0"
                    Padding="20,0" CornerRadius="0,0,10,10">
                <Grid>
                    <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"
                            Content="Cancel" Padding="18,10,18,10" Click="Cancel_Click"/>
                    <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"
                            Content="Save Entry" Padding="24,10,24,10" Click="Save_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</local:ChromeWindow>
