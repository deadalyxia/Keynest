<local:ChromeWindow x:Class="VaultApp.Views.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VaultApp.Views"
        Width="460" Height="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0D0D0D">

    <Border Background="#080810" BorderBrush="#1E1E32" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="MinimizeButton_Click"/>
                    <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
                    <TextBlock Text="KEYNEST" FontFamily="Segoe UI Light" FontSize="36"
                               FontWeight="Light" Foreground="#EEEAF8"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock x:Name="SubtitleText" Text="PASSWORD MANAGER"
                               FontFamily="Segoe UI" FontSize="9" Foreground="#4A4468"
                               HorizontalAlignment="Center" Margin="0,0,0,36"/>
                    <Border Width="28" Height="1" Background="#7B5CF0"
                            HorizontalAlignment="Center" Margin="0,0,0,36"/>

                    <StackPanel x:Name="ContentPanel"/>

                    <TextBlock x:Name="StatusText" Text="" Foreground="#D95F5F"
                               FontSize="12" HorizontalAlignment="Center"
                               TextWrapping="Wrap" Margin="0,14,0,0" TextAlignment="Center"/>
                    <Border Background="#0D0827" BorderBrush="#1E1E32" BorderThickness="0"
                            CornerRadius="6" Padding="0" Margin="0,6,0,0"
                            Visibility="Collapsed" x:Name="SubtitleBadge"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</local:ChromeWindow>
