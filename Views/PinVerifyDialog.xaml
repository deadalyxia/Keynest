<local:ChromeWindow x:Class="VaultApp.Views.PinVerifyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VaultApp.Views"
        Width="380" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#080810"
        ShowInTaskbar="False">

    <Border Background="#0E0E1A" BorderBrush="#1E1E32" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <Button HorizontalAlignment="Right" Style="{StaticResource ChromeCloseButton}"
                        Content="&#xE8BB;" Click="CloseButton_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="24,0">
                <TextBlock Text="Confirm Your Password" FontSize="14" FontWeight="SemiBold"
                           Foreground="#F0EDE8" Margin="0,0,0,6"/>
                <TextBlock Text="Enter your master password to authorise this action."
                           FontSize="12" Foreground="#585450" Margin="0,0,0,14"
                           TextWrapping="Wrap"/>
                <PasswordBox x:Name="PinBox" Style="{StaticResource DarkPasswordBox}"
                             KeyDown="PinBox_KeyDown"/>
                <TextBlock x:Name="ErrText" Text="" Foreground="#D95F5F"
                           FontSize="11" Margin="0,6,0,0"/>
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="#1A1A2E" BorderThickness="0,1,0,0" Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancel" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch" Padding="0,10,0,10" Click="Cancel_Click"/>
                    <Button Grid.Column="2" Content="Confirm" Style="{StaticResource DangerButton}"
                            HorizontalAlignment="Stretch" Padding="0,10,0,10" Click="Confirm_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</local:ChromeWindow>
