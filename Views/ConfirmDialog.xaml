<local:ChromeWindow x:Class="VaultApp.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VaultApp.Views"
        Width="400" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#080810"
        ShowInTaskbar="False">

    <Border Background="#0E0E1A" BorderBrush="#2A2020" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Drag bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <Button Grid.Row="0" HorizontalAlignment="Right" Style="{StaticResource ChromeCloseButton}"
                        Content="&#xE8BB;" Click="CloseButton_Click"/>
            </Grid>

            <!-- Body -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="28,0,28,0">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                           Foreground="#F0EDE8" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock x:Name="BodyText" FontSize="12" Foreground="#9A9088"
                           TextWrapping="Wrap" LineHeight="18"/>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" BorderBrush="#1A1A2E" BorderThickness="0,1,0,0" Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="CancelBtn" Content="Cancel"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch" Padding="0,10,0,10"
                            Click="Cancel_Click"/>
                    <Button Grid.Column="2" x:Name="ConfirmBtn"
                            HorizontalAlignment="Stretch" Padding="0,10,0,10"
                            Click="Confirm_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</local:ChromeWindow>
